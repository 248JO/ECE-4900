
#include "pico/stdlib.h"

#define LED_PIN 26

int main() {
    // Initialize GPIO26
    gpio_init(LED_PIN);

    // Set GPIO26 as output
    gpio_set_dir(LED_PIN, GPIO_OUT);

    while (true) {
        // Turn LED ON
        gpio_put(LED_PIN, 1);
        sleep_ms(1000);

        // Turn LED OFF
        gpio_put(LED_PIN, 0);
        sleep_ms(1000);
    }

    return 0;
}
